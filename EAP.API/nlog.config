<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">
  <targets async="true">
    <target xsi:type="Console" name="console"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} | ${level:uppercase=true} | ${message} | Trace=${scopeproperty:TraceId}${when:when='${scopeproperty:RequestId}' != '':inner= | RequestId=${scopeproperty:RequestId}}${onexception:inner= | Exception=${exception:format=tostring}}" />
    <target xsi:type="File" name="allFile"
            fileName="${basedir}/logs/eap-api-${shortdate}.log"
            archiveEvery="Day"
            archiveAboveSize="104857600"
            archiveNumbering="DateAndSequence"
            maxArchiveFiles="30"
            encoding="utf-8"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} | ${level:uppercase=true} | ${message} | Trace=${scopeproperty:TraceId}${when:when='${scopeproperty:RequestId}' != '':inner= | RequestId=${scopeproperty:RequestId}}${onexception:inner= | Exception=${exception:format=tostring}}" />
    <target xsi:type="File" name="errorFile"
            fileName="${basedir}/logs/error/eap-api-error-${shortdate}.log"
            archiveEvery="Day"
            archiveAboveSize="104857600"
            archiveNumbering="DateAndSequence"
            maxArchiveFiles="90"
            encoding="utf-8"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.fff} | ${level:uppercase=true} | ${message} | Trace=${scopeproperty:TraceId}${when:when='${scopeproperty:RequestId}' != '':inner= | RequestId=${scopeproperty:RequestId}}${onexception:inner= | Exception=${exception:format=tostring}}" />
  </targets>
  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.*" minlevel="Warn" writeTo="console,allFile" final="true" />
    <logger name="*" minlevel="Info" writeTo="console,allFile" />
    <logger name="*" minlevel="Error" writeTo="errorFile" />
  </rules>
</nlog>
